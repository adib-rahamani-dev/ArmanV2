{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "/(studio|digital|arman|user|admin)/?", "dest": "/api/index.php" },
    { "src": "/page\\.php", "dest": "/api/index.php" },
    { "src": "/api/(order|consultation|purchase|verification|track-order)\\.php", "dest": "/api/index.php" },
    { "src": "/admin/(api|document)\\.php", "dest": "/api/index.php" },
    { "src": "/verify\\.php", "dest": "/api/index.php" },
    { "src": "/index\\.php", "dest": "/api/index.php" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
