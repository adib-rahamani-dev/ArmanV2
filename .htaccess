Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

RewriteEngine On

# Three-surface architecture. Point every domain to this same document root.
# digital.* serves the digital shop and studio.* serves agency work.
RewriteCond %{HTTP_HOST} ^digital\. [NC]
RewriteRule ^$ digital/index.php [L]
RewriteCond %{HTTP_HOST} ^studio\. [NC]
RewriteRule ^$ studio/index.php [L]

# Dynamic, environment-aware crawler directives.
RewriteRule ^robots\.txt$ robots.php [L]

# Never expose application internals through the web server.
RewriteRule ^(?:config|data|database|includes|storage)(?:/|$) - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^404/?$ 404.php [L]

<FilesMatch "(^\.env|\.log$|schema\.sql$|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
  Header unset X-Powered-By
  <FilesMatch "\.(?:css|js|svg|png|jpe?g|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
